{
  "expo": {
    "name": "Unscratched",
    "slug": "unscratched",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unscratched",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.unscratched"
    },
    "android": {
      "package": "app.unscratched",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F6F3"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Unscratched uses the camera to photograph your rental's condition.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
